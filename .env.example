# Copie para .env e ajuste. Na VPS, o .env fica fora do Git.

# Chave das sessões: gere uma com  python -c "import secrets; print(secrets.token_hex(32))"
APP_SEGREDO=troque-por-uma-chave-longa-e-aleatoria

# Pasta do banco, planilhas e backups (padrão: ./dados)
# APP_DADOS=/www/wwwroot/comercialinterno/dados

# 1 = cookie só via HTTPS (ligue na VPS; deixe 0 para testar em http://localhost)
APP_COOKIE_SEGURO=0

# 1 = confia no X-Real-IP enviado pelo nginx (só vale para conexões vindas de 127.0.0.1)
APP_CONFIAR_PROXY=1

# Nome da empresa no cabeçalho do app (opcional)
# APP_EMPRESA=Minha Empresa
